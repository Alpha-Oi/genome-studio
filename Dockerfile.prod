# syntax=docker/dockerfile:1.7

# === Stage 1: Rust build ===
FROM rust:1.82-slim AS rust-builder

WORKDIR /build/core-rs
COPY core-rs/Cargo.toml core-rs/pyproject.toml ./
COPY core-rs/src ./src
RUN cargo build --release --no-default-features

# === Stage 2: Python build ===
FROM python:3.12-slim AS python-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN pip install --no-cache-dir uv==0.5.11

WORKDIR /build

COPY pyproject.toml ./
COPY backend/pyproject.toml backend/
COPY backend/README.md backend/
COPY backend/src ./backend/src

RUN uv sync --no-dev --package genome-studio-backend

# === Stage 3: UI build ===
FROM node:22-slim AS ui-builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /build/ui
COPY ui/package.json ui/tsconfig.json ui/tsconfig.node.json ui/vite.config.ts ui/index.html ./
COPY ui/src ./src
RUN pnpm install --frozen-lockfile
RUN pnpm build:prod

# === Stage 4: Runtime ===
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GS_BUILD=prod \
    GS_DEV_OVERRIDE_AVAILABLE=0

RUN groupadd -r gs && useradd -r -g gs -m -d /home/gs gs

WORKDIR /app

# Python venv
COPY --from=python-builder /build/.venv /app/.venv
COPY --from=python-builder /build/backend /app/backend

# Rust extension
COPY --from=rust-builder /build/core-rs/target/release/libgs_core.so /app/backend/src/genome_studio/_gs_core.so

# UI static
COPY --from=ui-builder /build/ui/dist /app/ui

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/backend/src"

USER gs

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "genome_studio.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
